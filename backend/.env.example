# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon, Supabase, Render, or local Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "false" only for local Postgres without SSL. Leave unset/"true" for hosted providers.
PGSSL=true

PORT=4000

# Comma-free single origin, or "*" for local dev
CORS_ORIGIN=http://localhost:5173,https://1-fi-project-frontend.vercel.app

# Google Cloud OAuth 2.0 Web Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# HMAC-SHA256 JWT Secret Key (generate a strong random secret in production)
JWT_SECRET=1fi-enterprise-fintech-jwt-hmac-sha256-secret-key-2026
